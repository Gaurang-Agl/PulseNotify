                  "        pm.expect(res.top_routes).to.be.an(\"array\");",
                  "    });",
                  "",
                  "    res.total_alerts !== undefined && pm.environment.set(\"total_alerts_count\", String(res.total_alerts));",
                  "}"
                ]
              }
            }
