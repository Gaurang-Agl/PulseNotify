                  "if (res) {",
                  "    pm.test(\"Alert created with active status and valid ID\", function () {",
                  "        pm.expect(res.id).to.be.a(\"number\");",
                  "        pm.expect(res.origin).to.eql(\"DEL\");",
                  "        pm.expect(res.destination).to.eql(\"BOM\");",
                  "        pm.expect(res.status).to.eql(\"active\");",
