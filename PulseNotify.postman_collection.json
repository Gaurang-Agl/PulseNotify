      "item": [
        {
          "name": "Register User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 & Response is JSON\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    pm.response.to.be.withBody;",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "const res = pm.response.code === 201 ? pm.response.json() : null;",
                  "",
                  "if (res) {",
                  "    pm.test(\"Response contains valid auth credentials\", function () {",
                  "        pm.expect(res.access).to.be.a(\"string\").and.not.empty;",
                  "        pm.expect(res.role).to.eql(\"user\");",
                  "        pm.expect(res.username).to.eql(\"alice\");",
                  "    });",
                  "",
                  "    res.access && pm.environment.set(\"user_token\", res.access);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
